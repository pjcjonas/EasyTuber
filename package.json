{
  "name": "easy-tuber",
  "productName": "EASY-TUBER",
  "version": "1.11.0",
  "description": "EASY-TUBER: upload your body parts and get a PNGTuber that breathes, blinks and talks to your microphone.",
  "main": "electron/main.js",
  "private": true,
  "repository": "github:pjcjonas/EasyTuber",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "dist": "npm run dist:win",
    "dist:win": "electron-packager . EASY-TUBER --platform=win32 --arch=x64 --out=dist --overwrite --icon=build/icon.ico --prune=true --ignore=\"^/(dist|saved|docs|tests|build/make-icon\\.py|build/logo-source\\.jpg|build/icon\\.icns|build/mac-extend\\.plist|server\\.py|start\\.bat|\\.claude|\\.github|\\.gitignore|README\\.md)\" --app-copyright=\"EASY-TUBER\" --win32metadata.ProductName=EASY-TUBER --win32metadata.FileDescription=EASY-TUBER",
    "dist:mac": "electron-packager . EASY-TUBER --platform=darwin --arch=x64,arm64 --out=dist --overwrite --icon=build/icon.icns --prune=true --ignore=\"^/(dist|saved|docs|tests|build/make-icon\\.py|build/logo-source\\.jpg|build/icon\\.ico|build/mac-extend\\.plist|server\\.py|start\\.bat|\\.claude|\\.github|\\.gitignore|README\\.md)\" --app-copyright=\"EASY-TUBER\" --app-bundle-id=com.pjcjonas.easytuber --app-category-type=public.app-category.entertainment --extend-info=build/mac-extend.plist"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3"
  },
  "dependencies": {
    "koffi": "^3.3.7"
  }
}
